# Copy to .env for local development. Never commit .env.
# In production, set these in the Render dashboard instead.

# Leave empty locally to use the built-in PGlite database (stored in .data/).
# In production: your Neon connection string, e.g.
# postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

PORT=3000

# 32+ random characters. Encrypts the stored Gmail App Password.
# Losing it means re-entering the App Password; nothing else is lost.
DATA_ENCRYPTION_KEY=replace-with-32-plus-random-characters
SESSION_SECRET=replace-with-another-32-plus-random-characters

# Creates the first admin account on first start (ignored once an admin exists).
ADMIN_BOOTSTRAP_ID=your-admin-id
ADMIN_BOOTSTRAP_PASSWORD=your-temporary-password
# Show the default credentials on the login page until the first sign-in (true/false).
SHOW_FIRST_LOGIN_CREDENTIALS=true

# Login-page hints. Hints only — never the real values.
ADMIN_HINT_ID=role_context
ADMIN_HINT_PASSWORD=role_context@length

# Recovery codes for the "#code" prompt. Never shown anywhere in the site.
# Default code: allows ONE sign-in with the default password within 15 minutes.
ADMIN_DEFAULT_CODE=choose-a-long-code
# Recovery code: opens "Queue recovery request" (can also be set in the admin).
ADMIN_RECOVERY_CODE=choose-a-different-long-code

# Sites allowed to read published content (the GitHub Pages copy), comma-separated origins.
PUBLIC_SITE_ORIGINS=https://vinayi220997.github.io
